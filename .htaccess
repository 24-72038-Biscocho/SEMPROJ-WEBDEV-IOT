Options -Indexes
RewriteEngine On

<FilesMatch "^(db\.php|.*\.sql)$">
    Require all denied
</FilesMatch>

<FilesMatch "^(\.env(\..*)?|composer\.(json|lock))$">
    Require all denied
</FilesMatch>

RewriteRule ^vendor/ - [F,L]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.php [QSA,L]
